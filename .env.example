# Copy to .env.local and replace placeholders.
# Values come from: Supabase → Project Settings → API

# Project URL  (e.g. https://abcdxyz.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# anon public key  (safe for browser; still keep repo private for band charts)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# service_role key  (SECRET — server/scripts only; never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Used for magic-link + invite email redirects (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: used by `npm run seed:admin` if you prefer not to pass CLI flags
# SEED_ADMIN_EMAIL=you@example.com
# SEED_ADMIN_NAME=Band Admin

# Optional: protects /api/ready (Authorization: Bearer <token>)
# READY_CHECK_TOKEN=long-random-string

# Optional: authenticated concurrency / upload verify scripts
# PERF_TEST_EMAIL=you@example.com
# BASE_URL=https://mb-live.vercel.app
# SKIP_LARGE=1
